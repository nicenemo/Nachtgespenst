{
  "permissions": {
    "additionalDirectories": [
      "/tmp"
    ],
    "blockReadsOutsideWorkingDirectories": false,
    "blockWritesOutsideWorkingDirectories": false
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "~/"
      ],
      "allowRead": [
        ".",
        "~/jbinst",
        "~/.jbang",
        "~/.m2",
        "~/.sdkman",
        "~/.gitconfig",
        "~/.config/git"
      ],
      "allowWrite": [
        ".",
        "/tmp",
        "~/.jbang",
        "~/.m2"
      ]
    },
    "network": {
      "allowedDomains": [
        "dl.registry.platformio.org",
        "registry.platformio.org",
        "api.registry.platformio.org",
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "repo.maven.apache.org",
        "repo1.maven.org",
        "jitpack.io",
        "api.foojay.io",
        "www.usb.org"
      ]
    },
    "excludedCommands": [
      "*pio run*upload*",
      "*pio device*",
      "*pio test*",
      "*esptool*",
      "*jbang*SerialTest*",
      "bluetoothctl list*",
      "bluetoothctl show*",
      "bluetoothctl devices*",
      "bluetoothctl paired-devices*",
      "bluetoothctl info*",
      "gh *",
      "git push*",
      "git pull*",
      "git fetch*",
      "git ls-remote*"
    ]
  }
}
